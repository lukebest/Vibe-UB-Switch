# Single-test cocotb invocation. Variables come from the environment / command line.
TOPLEVEL_LANG ?= verilog
SIM           ?= verilator
WAVES         ?= 0

PYUVM := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
VENV  := $(PYUVM)/.venv
export PATH := $(VENV)/bin:$(PATH)
export PYTHONPATH := $(PYUVM):$(PYTHONPATH)

PLUSARGS += +UVM_TESTNAME=$(UVM_TESTNAME)
export UVM_TESTNAME

ifeq ($(SIM),verilator)
# --timing: fabric wrapper `initial` preload (NEEDTIMINGOPT). --public-flat-rw: Force internals.
# -Wno-BLKLOOPINIT / --unroll-count 256: vibe_route_lu tbl[*] reset loop (DEPTH=256).
EXTRA_ARGS += --timescale 1ns/1ps -Wno-fatal --public-flat-rw -Wno-BLKLOOPINIT --unroll-count 256 --timing
endif
ifeq ($(SIM),icarus)
COMPILE_ARGS += -g2012
endif

COCOTB_REDUCED_LOG_FMT ?= 1
export COCOTB_REDUCED_LOG_FMT

include $(shell $(VENV)/bin/cocotb-config --makefiles)/Makefile.sim
